{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "auryn",
      "camelcase": "Auryn",
      "title": "Auryn",
      "scope": "source.auryn",
      "file-types": [
        "au"
      ],
      "injection-regex": "^auryn$",
      "class-name": "TreeSitterAuryn"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "parser for the auryn programming language",
    "authors": [
      {
        "name": "Inky-developer",
        "email": "inky@mailbox.org",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-auryn",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
